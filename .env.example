# BitSPV Pay — 环境变量模板
#
# 这个文件不会被 Vite 加载（它只读 .env / .env.local / .env.[mode] / .env.[mode].local），
# 作用只有一份：告诉后来的人需要哪些键。
#
# 用法：
#   cp .env.example .env.local      # 然后填值；.env.local 已被 .gitignore 挡住
#
# 生产环境：这些值配在 Vercel 项目的 Environment Variables 里，
# 不要写进任何被提交的文件。

# TAAL / ARC 的 bearer token，用于查 tx 和广播。
# ⚠️ VITE_ 前缀的变量在构建时会被字面量内联进浏览器 JS，
#    所以它对每个访客可见 —— 它不是秘密，请按「可轮换、有限额」来管：
#    泄漏了就去 TAAL 换一个，而不是指望它藏得住。
VITE_AUTH_TOKEN=

# TAAL API key（src/utils/api.js 里发交易时用），同上，同样是公开的。
VITE_TAAL_API_KEY=

# 只给 scripts/notify.sh 用（部署预览通知），不会进浏览器。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
